VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=replace-with-local-public-key

# Optional in local/preview. Set to the canonical HTTPS app origin in production, e.g. https://app.fieldlance.app
VITE_PUBLIC_APP_ORIGIN=

# Server/CLI only. Never prefix privileged credentials with VITE_.
SUPABASE_SECRET_KEY=replace-with-server-secret-only-if-needed
SUPABASE_ANON_KEY=replace-with-local-public-key
